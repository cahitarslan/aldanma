<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Aldanma.Core</PackageId>
    <Version>0.5.0</Version>
    <Description>Dependency-free engine that recognises Turkish scam messages, classifies phone numbers, IBANs and links, and combines community reports into a risk score.</Description>
    <PackageTags>scam;fraud;phishing;smishing;iban;turkey</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth: rules/rules.json at the repository root. The JS engine reads the same file. -->
    <EmbeddedResource Include="..\..\rules\rules.json" LogicalName="Aldanma.rules.json" Link="rules.json" />
    <InternalsVisibleTo Include="Aldanma.Tests" />
  </ItemGroup>

</Project>
