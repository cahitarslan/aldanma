# Copy to .env (never commit .env). Generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Database pool per API instance and per-command timeout (seconds). Keep pool x max instances under the database's
# connection limit. Used by docker-compose.yml; on Cloud Run put them in the connection string (docs/DEPLOY.md).
DB_MAX_POOL_SIZE=20
DB_COMMAND_TIMEOUT=10
# Keyed hash secret for phone numbers, IBANs and reporter IPs. Changing it orphans every stored record: back it up.
ALDANMA_HASH_KEY=
# Unlocks /api/admin/* via the X-Admin-Key header. Leave empty to disable moderation endpoints.
ALDANMA_ADMIN_KEY=
# Cloudflare Turnstile secret (the site key goes to the static build). Empty disables the human check.
ALDANMA_TURNSTILE_SECRET=
ALDANMA_SITE_ORIGIN=https://aldanma.cahitarslan.com
# Header the reverse proxy sets with the client IP (CF-Connecting-IP if Cloudflare proxies the API directly).
ALDANMA_CLIENT_IP_HEADER=X-Forwarded-For
# Optional moderation e-mails through Resend (counts only). All three set = on. Use a key with sending access only.
ALDANMA_NOTIFY_RESEND_API_KEY=
ALDANMA_NOTIFY_FROM=
ALDANMA_NOTIFY_TO=
# Optional OpenTelemetry collector for traces and metrics, e.g. http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
