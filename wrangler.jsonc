{
  // Cloudflare Workers static site. Build with "npm run build:web"; only dist/ is served. No server code here:
  // the API is a separate .NET service (see src/Aldanma.Api and docs/DEPLOY.md).
  "name": "aldanma",
  "compatibility_date": "2026-11-01",
  // Branch builds deploy with "wrangler preview", which requires this block (it can stay empty).
  "previews": {},
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
